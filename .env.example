# Shared Turso / libSQL (same as sibling games river-raid-lite / rtypeweb).
# Leave unset for local file SQLite at data/games.db
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# Required in production. For local dev a default is used with a console warning.
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: override handoff signing secret (defaults to PORTAL_SESSION_SECRET)
# PORTAL_HANDOFF_SECRET=

# Local API listen port (default 3000)
# PORT=3000
